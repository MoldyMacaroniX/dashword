    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or metadata.title }} | {{ metadata.name }}</title>

    <script>
        // Immediately invoked function to prevent theme flashing
        (function () {
            const savedTheme = localStorage.getItem('theme') || 'system';
            const htmlElement = document.documentElement;
            if (savedTheme === 'dark' || (savedTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                htmlElement.classList.add('dark');
            } else {
                htmlElement.classList.remove('dark');
            }
            // Also keep track of the exact current setting string if needed for CSS attribute styling
            htmlElement.setAttribute('data-theme', savedTheme);
        })();
    </script>

    <link rel="stylesheet" href="/assets/css/index.css">

    <link rel="icon" href="/assets/branding/logo.svg" type="image/svg+xml">
